!@
!@      DO 4190 J19=1,VTD%L_NZO
!@!
!@! --- If we have a GNSS satellite, we need to build PCO/PCV objects,
!@! --- to do this, we need to get the antenna types of stations and sources
!@!
!@      IF ( FL_PCO .AND. ILEN(VTD%CONF%FINAM_PHASE_OFFS) > 0 ) THEN
!@           NUM_ANTENNAS = 0
!@           DO 4200 J20=1,VTD%L_STA
!@!
!@! ----------- First get receiver antenna types
!@!
!@              IF ( VTD%STA(J20)%MOUNT_TYPE == 'GNSS' ) THEN
!@!
!@! ---------------- Extract the antenna types
!@!  
!@                   IS_UNIQUE = .TRUE.
!@                   DO 4210 J21=1,NUM_ANTENNAS
!@                      IF ( TRIM(VTD%STA(J20)%ANTEX_TYPE) == TRIM(ANTENNA_TYPES(J21)) ) THEN
!@                           IS_UNIQUE = .FALSE.
!@                           GOTO 8210
!@                      END IF
!@ 4210              CONTINUE
!@ 8210              CONTINUE
!@                   IF ( IS_UNIQUE ) THEN
!@                        IF ( NUM_ANTENNAS == VTD__M_PCO ) THEN
!@                             CALL ERR_LOG ( 2442, IUER, 'VTD_LOAD_NZO', 'Error in an '// &
!@     &                           'attempt to load PCO/PCV data into VTD: '// &
!@     &                           'too many antenna types, either reduce '//  &
!@     &                           'number of antennas or increase VTD__M_PCO' )
!@                             RETURN
!@                        END IF
!@                        NUM_ANTENNAS = NUM_ANTENNAS + 1
!@                        ANTENNA_TYPES(NUM_ANTENNAS) = TRIM ( VTD%STA(J20)%ANTEX_TYPE )
!@                   END IF
!@              END IF
!@ 4200       CONTINUE
!@!
!@           DO 4220 J22=1,VTD%L_NZO
!@!
!@! ----------- Now get source/transmitter antenna types
!@!
!@              IS_UNIQUE = .TRUE.
!@              SOU_ANT_NAME = VTD%NZO(J22)%NAME
!@              DO 4230 J23=1,NUM_ANTENNAS
!@                 IF ( TRIM(SOU_ANT_NAME) == TRIM(ANTENNA_TYPES(J23)) ) THEN
!@                      IS_UNIQUE = .FALSE.
!@                      GOTO 8230
!@                 END IF
!@ 4230         CONTINUE
!@ 8230         CONTINUE
!@              IF ( IS_UNIQUE ) THEN
!@                   NUM_ANTENNAS = NUM_ANTENNAS + 1
!@                   ANTENNA_TYPES(NUM_ANTENNAS) = SOU_ANT_NAME
!@              END IF
!@ 4220      CONTINUE
!@!
!@! -------- Read phase-windup or feed rotation of satellites by parsing 
!@! -------- a file in ASCII antex format.
!@!
!@           IF ( PCO_FMT == 'ascii' .OR. PCO_FMT == 'ASCII' ) THEN
!@                CALL ERR_PASS ( IUER, IER )
!@                CALL VTD_READ_ANTEX ( VTD, NUM_ANTENNAS, ANTENNA_TYPES, IER )
!@                IF ( IER .NE. 0 ) THEN
!@                     CALL ERR_LOG ( 2443, IUER, 'VTD_LOAD_NZO', 'Error in an '// &
!@     &                   'attempt to load PCO/PCV data into VTD '// &
!@     &                   'data structure' )
!@                     RETURN
!@                END IF
!@                VTD%L_PCO = NUM_ANTENNAS
!@           END IF
!@      END IF
