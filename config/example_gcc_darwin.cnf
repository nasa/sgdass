# sgdass_config  Version 1.4   of 2021.12.13
#
# Configuration file for compiling gcc/g++/gfortran at MACOS (Darwin)
# Tested under (Darwin) OS 13.5.2 and xcode 14.2
# Tested under (Darwin) OS 14.5.2 and xcode 14.3
# Tested under (Darwin) OS 15.5   and xcode 15.3
#
# Last update: 2025.07.15_11:06:29
#
[Directories]
  /opt64

[SubDirectories]:
  /opt64/include
  /opt64/lib
  /opt64/lib64
  /opt64/bin

[Compilers]
  gcc           /usr/bin/gcc 
  gcx           /usr/bin/g++
  gfortran      none
  cla           /usr/bin/clang
  clap          /usr/bin/clang++
  cmake         none

[Where]
  tarball       /progs/sgdass       # directory with unpacked sgdass tarballs
  build         /progs              # build directory the primary packages
  build_aux     /dist               # build directory for axilliary third party packages
  prefix        /opt64              # installation directory
  sdk           /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk  # Mac OS software development kit
  xcode         /Applications/Xcode.app                              # Xcode mac OS development kit

[Misc]
  num_proc      64
  center_abr    AG
  center_name  "NASA GSFC"
  install_log   /logs/sgdass/sgdass_@DATE@_install.log
  build_log     /logs/sgdass/sgdass_@DATE@_build.log

[Tests]

[AuxPackages]
  package: gmp
  version: 6.3.0
           options:     --prefix=${prefix} \
                        --enable-cxx       \
                        CC=${gcc}
           build:       make clean
           build:       make -j ${num_proc}
           build:       make install

#
  package: mpfr
  version: 4.2.1
           options:     --prefix=${prefix}   \
                        --with-gmp=${prefix} \
                        --enable-shared      \
                        --enable-thread-safe \
                        CC=${gcc}
           build:       make clean
           build:       make -j ${num_proc}
           build:       make install

#
  package: mpc
  version: 1.4.1
           options:     --prefix=${prefix}   \
                        --with-gmp=${prefix} \
                        --enable-shared      \
                        CC=${gcc}
           build:       make clean
           build:       make -j ${num_proc}
           build:       make install

#
  package: isl
  version: 0.18
           options:     --prefix=${prefix}   \
                        --with-gmp=${prefix} \
                        CC=${gcc}            \
                        CFLAGS="-I ${prefix}/include" \
                        LDFLAGS="-L${prefix}/lib"
           build:       make clean
           build:       make -j ${num_proc}
           build:       make install

#
  package: zstd
  version: 1.5.2
           patch:       zstd-01.patch
           build:       make clean
           build:       make -j ${num_proc}
           build:       make install DESTDIR=${prefix}

#
  package: gcc
  version: 16.1.0
           pre_config:   if ( -d build ) rm -fR build
           pre_config:   mkdir -p build/gcc
           pre_config:   cp ${sdk}/usr/include/AvailabilityInternalLegacy.h build/gcc/
           pre_config:   mkdir -p ${prefix}/x86_64-apple-darwin22.6.0/include/
           pre_config:   cp ${sdk}/usr/include/AvailabilityInternalLegacy.h ${prefix}/x86_64-apple-darwin22.6.0/include/
           pre_config:   cp ${tarball}/ecj-4.9.jar build/
           with_config:  cd build
           with_config:  cp ../configure  ./
           options:      --prefix=${prefix}     \
                         --with-gmp=${prefix}   \
                         --with-mpc=${prefix}   \
                         --with-mpfr=${prefix}  \
               	         --without-isl          \
                         --with-sysroot=${sdk}  \
                         --disable-nls          \
                         --disable-multilib     \
                         --enable-shared        \
                         --enable-threads=posix \
                         --enable-lto           \
                         --enable-languages=c,c++,fortran,objc,obj-c++ \
                         CC=${cla}              \
			 CXX=${clap}

            build:      make -j ${num_proc}
            build:      make install
            build:      if ( -f ${prefix}/bin/cc ) rm ${prefix}/bin/cc 
            build:      ln -s ${prefix}/bin/gcc ${prefix}/bin/cc 

#
#  Special tricks to proceed:
#
#  1) 2024.01.28
#
#     Building of gcc failed. Workaround to continue for xcode 14.2 and darwin OS 13.5:
#     after it stoped with an error message:
#
#  cd /dist/gcc-13.1.0/build/
#  cp /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/AvailabilityInternalLegacy.h prev-gcc/include-fixed/
#  make -j 8    >& make_log_try2.txt
#  make install >& install.log
#
#  2) 2025.07.15
#     Building of gcc failed. Workaround to continue for xcode 15.3 and darwin OS 15.5
#     after it stoped with an error message:
#
# cd /dist/gcc-15.1.0/build/x86_64-apple-darwin24.5.0/libgfortran
# find ./ -name kinds.h -exec sed -i -e 's@GFC_REAL_10_HUGE l@GFC_REAL_10_HUGE 1.7976931348623157e308@g'  {} \;
# find ./ -name kinds.h -exec sed -i -e 's@GFC_REAL_10_TINY l@GFC_REAL_10_TINY 2.2250738585072014e-308@g' {} \;
# find ./ -name kinds.h -exec sed -i -e 's@GFC_REAL_10_LITERAL(X) (X ## l)@GFC_REAL_10_LITERAL(X) (X)@g'  {} \;
# find ./ -name kinds.h -exec sed -i -e 's@GFC_REAL_10_LITERAL_SUFFIX l@GFC_REAL_10_LITERAL_SUFFIX@g'     {} \;
# find ./ -name kinds.h -exec sed -i -e 's@GFC_REAL_16_HUGE q@GFC_REAL_16_HUGE 1.7976931348623157e308@g'  {} \;
# find ./ -name kinds.h -exec sed -i -e 's@GFC_REAL_16_TINY q@GFC_REAL_16_TINY 2.2250738585072014e-308@g' {} \;
# find ./ -name kinds.h -exec sed -i -e 's@GFC_REAL_16_LITERAL(X) (X ## q)@GFC_REAL_16_LITERAL(X) (X)@g'  {} \;
# find ./ -name kinds.h -exec sed -i -e 's@GFC_REAL_16_LITERAL_SUFFIX q@GFC_REAL_16_LITERAL_SUFFIX@g'     {} \;
# make -j 8    >& make_log_try2.txt
# make install >& install.log
#
#
  package: cmake
  version: 4.3.2
           pre_config:  sed -i -e 's@"lib64"@"lib"@g' Modules/GNUInstallDirs.cmake
           options:     noconfigure
           build:       ./bootstrap                   \
                        --prefix=/opt64               \
                        --no-system-libs              \
                        --parallel=8                  \
                        --datadir=/share/cmake        \
                        --docdir=/share/doc/cmake     \
                        --mandir=/share/man           \
                         CC=${cla}                    \
                         CXX=${clap}                  \
                        --                            \
                        -DCMAKE_INSTALL_PREFIX=/opt64 \
                        -DCMAKE_INSTALL_LIBDIR=lib    \
                        -DCMAKE_BUILD_TYPE=Release    \
                        -DCMAKE_FIND_FRAMEWORK=LAST   \
                        -DCMAKE_VERBOSE_MAKEFILE=ON   \
                        -Wno-dev                      \
                        -DBUILD_TESTING=OFF           \
                        -DCMAKE_OSX_SYSROOT=${sdk}    \
                        -DCMake_BUILD_LTO=ON

           build:       make -j ${num_proc} V=1
           build:       make install
